# --- Obligatorii ---
# Baza de date PostgreSQL (ex: Neon, Supabase, Railway)
DATABASE_URL="postgresql://user:parola@host:5432/invitonline"
# Secret pentru sesiuni (genereaza cu: npx auth secret  sau  openssl rand -base64 32)
NEXTAUTH_SECRET="schimba-ma"
# Adresa publica a site-ului (fara / la final)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Plati (Stripe) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Incarcare poze / muzica / video (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Emailuri (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="InvitOnline <contact@invitonline.ro>"
ADMIN_EMAIL="contact@invitonline.ro"
# E-mailurile automate (bun venit, ciorna neactivata, sfaturi dupa plata, rezumat RSVP, revenire):
# POST /api/cron/emails cu antetul "Authorization: Bearer $CRON_SECRET", la 15 minute (vezi src/lib/lifecycle/run.ts).
# Minim 16 caractere (openssl rand -hex 32). Gol = cronul raspunde 401. ?dry=1 doar numara, ?limit=N (max 50).
CRON_SECRET=""

# --- Admin si mydashboard.ro ---
# Adresele (separate prin virgula) care pot deschide /admin: conturi, plati, incasari azi/7/30 zile/total.
# Gol = /admin raspunde 404 pentru toti. Contul cu adresa respectiva trebuie creat INAINTE (inregistrarea
# nu verifica adresa de e-mail). ADMIN_EMAIL de mai sus e doar destinatarul notificarilor, nu da acces.
ADMIN_EMAILS=""
# Statistici pentru mydashboard.ro (GET /api/mydashboard/stats, antet x-stats-token). Gol = endpoint 404.
# Valoarea: HMAC-SHA256(CRON_SECRET din mydashboard, "stats:invitonline") - comanda e in README-ul mydashboard.ro.
MYDASHBOARD_STATS_TOKEN=""
# Alerte catre mydashboard.ro (erori Stripe/Oblio/Resend/checkout, cote Cloudinary). Gol = nu trimite nimic.
MYDASHBOARD_ALERT_TOKEN=""

# --- Optional ---
# Autocomplete pentru locatii (fara cheie merge camp text simplu + link Google Maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Facturare automata Oblio
OBLIO_EMAIL=""
OBLIO_API_KEY=""
OBLIO_CIF_FIRMA=""
OBLIO_SERIE_FACTURA=""
# Optional: numele unei cote TVA din nomenclatorul Oblio al firmei. Lasat gol (implicit), factura nu impune
# nicio cota si se aplica setarea firmei (neplatitor de TVA).
# OBLIO_VAT_NAME=""

# TikTok Pixel (se incarca doar cu acord pentru cookies de marketing)
NEXT_PUBLIC_TIKTOK_PIXEL_ID="DATFVURC77U3L597V800"

# TikTok Events API (server-side CompletePayment dupa plata, doar cu acord pentru marketing; fara token nu trimite nimic)
TIKTOK_EVENTS_TOKEN=""
# Optional: pixelul pentru Events API (implicit DATFVURC77U3L597V800)
TIKTOK_PIXEL_ID=""
# Doar pentru teste (Events Manager > Test events); gol in productie
TIKTOK_TEST_EVENT_CODE=""
