generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  // null for accounts created with Google or an e-mail link (no password yet)
  password      String?
  name          String?
  emailVerified DateTime?
  googleId      String?  @unique
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Billing Details
  companyName   String?
  cui           String?
  regCom        String?
  address       String?
  city          String?
  county        String?
  bank          String?
  iban          String?

  // Acceptarea Termenilor la crearea contului
  termsAcceptedAt DateTime?
  termsVersion    String?

  // Bifa „Nu vreau emailuri cu sfaturi și noutăți” de la înregistrare sau dezabonarea din e-mail
  // (Legea 506/2004 art. 12 alin. 2), cu momentul alegerii
  marketingOptOut   Boolean   @default(false)
  marketingChoiceAt DateTime?

  events        Event[]
  orders        Order[]
  emailLogs     EmailLog[]
}

// One-time e-mail links: sign-in without password ("login") and password reset ("reset").
// Only the SHA-256 of the token is stored; the link carries the token itself.
model AuthToken {
  id           String    @id @default(uuid())
  email        String
  tokenHash    String    @unique
  purpose      String    // login | reset
  // terms accepted in the request form (sign-in link that may create the account)
  termsVersion String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
}

// Stripe webhook events already handled (idempotency across retries)
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model Event {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String   // nunta, botez, etc
  template        String   // envelope, netflix, etc
  title           String
  date            String
  location        String
  locationUrl     String?  // Google Maps Link
  invitationLink  String?  @unique
  message         String?
  data            Json     // Store full flexible JSON data for template specific fields
  isPaid          Boolean  @default(false)
  // first activation (payment confirmed)
  publishedAt     DateTime?
  stripeSessionId String?  @unique
  guests          Guest[]
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Order {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  eventId         String?
  event           Event?    @relation(fields: [eventId], references: [id])
  amount          Float
  currency        String   @default("RON")
  stripeSessionId String?  @unique
  status          String   @default("pending") // pending, completed, failed
  
  // Invoice Info
  invoiceSeries   String?
  invoiceNumber   String?
  invoiceLink     String?

  // Acordul la plata: termeni + furnizare imediata / pierderea dreptului de retragere (OUG 34/2014)
  termsAcceptedAt DateTime?
  termsVersion    String?

  createdAt       DateTime @default(now())
}


model Guest {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  contact   String   // Email or Phone
  persons   Int      @default(1)
  status    String   @default("pending") // pending, confirmed, declined
  message   String?
  // menu preference chosen in the RSVP form (options come from Event.data.menuOptions)
  menu      String?
  // personal invitation link (/invitatie/<event>?g=<token>) for guests added by the organizer
  token     String?  @unique
  respondedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Momentul lansarii e-mailurilor din ciclul de viata (randul 1, pus de migrare).
// Doar conturile create dupa el primesc e-mailurile periodice.
model EmailSettings {
  id                  Int      @id @default(1)
  lifecycleLaunchedAt DateTime @default(now())
}

// Fiecare e-mail din ciclul de viata (si confirmarile de plata): cine, ce fel, cand, rezultatul.
// dedupeKey unic („adresa:fel”, la rezumatul RSVP „adresa:fel:eveniment”) opreste dublurile;
// o trimitere esuata isi elibereaza cheia (NULL). Id-ul (uuid aleator) e cheia linkului de dezabonare.
model EmailLog {
  id        String   @id @default(uuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // invitatia la care se refera e-mailul (ciorna, rezumat RSVP); fara cheie straina, invitatia se poate sterge
  eventId   String?
  kind      String
  dedupeKey String?  @unique
  sentAt    DateTime @default(now())
  resendId  String?
  error     String?

  @@index([email, sentAt(sort: Desc)])
  @@index([kind, sentAt(sort: Desc)])
  @@index([userId])
}

// Adresele dezabonate (din linkul din e-mail sau din antetul List-Unsubscribe)
model EmailUnsubscribe {
  email          String   @id
  unsubscribedAt DateTime @default(now())
  emailLogId     String?
}
